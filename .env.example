# ─────────────────────────────────────────────────────────────
# loen-frontend 환경변수 예시 — 실제 값은 .env(로컬) / EAS env vars(빌드)에 둔다.
# .env 는 gitignore 됨. 이 파일을 복사해 .env 로 쓰거나 `eas env:pull` 로 받는다.
# ─────────────────────────────────────────────────────────────

# ── 환경 스위치 (app.config.js) ──────────────────────────────
# dev/prod 의 앱 정체성(이름·bundleId·package·google-services·iOS scheme)을 가른다.
#   development → Loen (Dev) / com.loen.app.dev / Pi dev 백엔드   (로컬 기본)
#   production  → Loen       / com.loen.app     / Railway
APP_ENV=development

# ── 백엔드 API ───────────────────────────────────────────────
# dev: 라즈베리파이(Tailscale)  /  prod: Railway
EXPO_PUBLIC_API_URL=http://100.94.26.19:8080/api/v1
# EXPO_PUBLIC_API_URL=https://loen-backend-production.up.railway.app/api/v1

# ── Google OAuth Client IDs ──────────────────────────────────
# web 은 dev/prod 공용(백엔드 GOOGLE_CLIENT_ID = idToken audience).
# ios/android 는 환경별로 다른 클라이언트(번들 com.loen.app vs com.loen.app.dev).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=<web-client-id>.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=<ios-client-id>.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=<android-client-id>.apps.googleusercontent.com

# ─────────────────────────────────────────────────────────────
# EAS 빌드/업데이트는 이 파일이 아니라 EAS Environment Variables 를 본다.
# 환경(development/production)별로 위 값들 + GOOGLE_SERVICES_JSON(파일 시크릿)을
# EAS 대시보드 또는 `eas env:create` 로 등록한다.
#
#   eas env:create  --environment development --name EXPO_PUBLIC_API_URL --value http://100.94.26.19:8080/api/v1
#   eas env:pull    --environment development      # → .env.local 로 로컬 동기화
#
# 빌드:   eas build  --profile development   # Loen (Dev), Pi 백엔드
#         eas build  --profile production    # Loen,       Railway
# OTA:    eas update --channel development    /    --channel production
# ─────────────────────────────────────────────────────────────
